# Copy to ".env" in this directory (same folder as bot.py / langgraph.json).
# Get a key: https://smith.langchain.com/settings -> API Keys
# Never commit real keys; keep secrets only in ".env" (gitignored).

LANGSMITH_API_KEY=

# Real bot (python bot.py / ClawBot service): send LangGraph/LC runs to LangSmith Tracing.
LANGCHAIN_TRACING_V2=true

# Optional: default project name in LangSmith UI (easier to filter).
# LANGSMITH_PROJECT=clawbot

# Optional: set to "false" to disable sending traces.
# LANGSMITH_TRACING=false

# QWeather API Key (daily briefing)
QWEATHER_API_KEY=
